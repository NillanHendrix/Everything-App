VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Nur serverseitig (api/wow.ts, auf Vercel oder via server/index.mjs), kein VITE_-Präfix. Client anlegen unter https://develop.battle.net
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Optional für `npm run dev`: /api an ein Deployment weiterleiten (Vercel oder Coolify),
# oder lokal `npm run build && npm start` und hier http://localhost:3000 eintragen.
API_PROXY_TARGET=
